# ============================================================
# 个人bookmark —— 环境变量模板
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交
#
# 生成随机值（Linux / NAS 上）：
#   echo "DB_PASSWORD=$(openssl rand -base64 24)"
#   echo "AUTH_SECRET=$(openssl rand -base64 32)"
# 没有 openssl 就用 Node：
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ============================================================

# ── 必填 ───────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME
AUTH_SECRET=CHANGE_ME

# ── 管理员密码（可选） ─────────────────────────────────
# 留空 = 首启随机生成，并打印到 pb-web 日志。
# 填了就优先用它，省得去翻日志。
# 注意：只在 data/config/auth.json 不存在时生效；文件一旦生成就以文件为准。
ADMIN_PASSWORD=

# ── 基础 ───────────────────────────────────────────────
APP_NAME=个人bookmark
APP_SHORT=pb
# 供 PWA、分享链接使用。局域网 http 也能跑，但「添加到主屏幕」需要 https
PUBLIC_BASE_URL=http://localhost:3000
# 宿主机端口。NAS 上避开 80 / 443（系统 Web UI 占用）
WEB_PORT=3000
TZ=Asia/Shanghai

# ── 存储路径（容器内，一般不用改） ─────────────────────
ASSETS_DIR=/data/assets
CONFIG_DIR=/data/config

# ── 抓取限制 ───────────────────────────────────────────
MAX_HTML_BYTES=8388608
MAX_ASSET_BYTES=20971520
FETCH_TIMEOUT_MS=20000
WORKER_CONCURRENCY=3

# ── 图片存储（只存压缩图，原图不落盘，见 ADR-013） ─────
# display 变体是唯一长期副本，别调太低
DISPLAY_MAX_EDGE=2000
DISPLAY_WEBP_QUALITY=85

# ── 「预览原图」按需回源 ───────────────────────────────
MAX_SOURCE_BYTES=33554432
SOURCE_FETCH_TIMEOUT_MS=15000
# 内存 LRU 张数，不落盘。设 0 关闭缓存
SOURCE_CACHE_ITEMS=50

# ── 分类与 AI ──────────────────────────────────────────
# 留空则关闭 L3（LLM 打标签/摘要），L1 规则与 L2 向量传播仍然工作
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
EMBEDDING_ENABLED=true

# ── 平台开关 ───────────────────────────────────────────
# 抖音视频本体默认不下载（体积大、直链会过期）
DOUYIN_DOWNLOAD_VIDEO=false
BROWSER_TOKEN=

# ── 容器行为 ───────────────────────────────────────────
# 启动时自动跑迁移。若想手动 docker compose exec pb-web 迁移，设 false
AUTO_MIGRATE=true

# ── 镜像命名 ───────────────────────────────────────────
# 本地构建用 local；推到 registry 后改成版本号或 latest
TAG=local
IMAGE_PREFIX=pb

# ── 文件权限（可选，见 docker-compose.yml 备注 1） ─────
# 默认容器以 root 运行。若想把 ./data 下文件改成 NAS 账号所有：
#   1) ssh 到 NAS 执行 id，记下 uid/gid（绿联常见是 1000）
#   2) sudo chown -R 1000:1000 data
#   3) 在 compose 里给 pb-web / pb-worker 各加一行 user: "1000:1000"
# PUID=1000
# PGID=1000
